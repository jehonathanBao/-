FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /home/toxic toxic

COPY release-bin/btc-toxic-flow-monitor-rs ./btc-toxic-flow-monitor-rs
COPY release-bin/cwm_v4_backfill ./cwm_v4_backfill
COPY release-bin/cwm_v42_backfill ./cwm_v42_backfill
COPY config ./config

RUN mkdir -p /app/data /app/.runtime \
    && chown -R toxic:toxic /app /home/toxic

USER toxic

EXPOSE 3000

ENV RUST_LOG=info \
    READ_ONLY=true \
    API_HOST=0.0.0.0 \
    API_PORT=3000 \
    SQLITE_PATH=/app/data/btc-toxic-flow.sqlite \
    REPLAY_REPORT_DIR=/app/data/reports

CMD ["./btc-toxic-flow-monitor-rs"]
