server {
  listen 5173;
  server_name _;

  gzip on;
  gzip_vary on;
  gzip_proxied any;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss image/svg+xml;

  root /usr/share/nginx/html;
  index index.html;

  location ^~ /api/system/ {
    return 404;
  }

  location = /api/contract-whale/pipeline-debug {
    return 404;
  }

  location = /api/contract-whale/raw-flow-debug {
    return 404;
  }

  location = /api/contract-whale/latency-debug {
    return 404;
  }

  location = /api/binance-alt-contract/runtime-debug {
    return 404;
  }

  location = /api/new-token-watch/runtime-debug {
    return 404;
  }

  location /api/ {
    if ($request_method = POST) {
      return 403;
    }
    proxy_pass http://backend:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Operator-Api-Token ${OPERATOR_TOKEN};
    proxy_set_header Origin ${INTERNAL_API_ORIGIN};
  }

  location /ws/ {
    proxy_pass http://backend:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Operator-Api-Token ${OPERATOR_TOKEN};
    proxy_set_header Origin ${INTERNAL_API_ORIGIN};
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location = /index.html {
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
