LIQ_HUNT_LIKELY_SCORE=50
LIQ_HUNT_WATCH_SCORE=30

FLOW_COMPUTE_INTERVAL_MS=250
MARKOUT_RESOLVE_INTERVAL_MS=250
SWEEP_COMPUTE_INTERVAL_MS=250
TOXIC_COMPUTE_INTERVAL_MS=250

BOOK_STALE_MS=5000
MAX_BUFFER_AGE_MS=120000
