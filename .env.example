APP_ENV=development
READ_ONLY=true

API_HOST=127.0.0.1
API_PORT=3000
WS_SIGNAL_INTERVAL_MS=1000
SCAN_LOG_BUFFER_SIZE=200
TOF_ENABLED=true
TOF_VPIN_BUCKET_VOLUME=100000
TOF_VPIN_BUCKET_COUNT=20
TOF_VPIN_HIGH_THRESHOLD=70
TOF_DEPTH_LEVELS=10
TOF_DEPTH_WITHDRAWAL_THRESHOLD=35
TOF_SPREAD_WIDENING_BPS=8
TOF_ORDER_CHURN_THRESHOLD=70
TOF_SCORE_WEIGHT_EXISTING=0.60
TOF_SCORE_WEIGHT_METRICS=0.40
TOF_SCAN_LOG_INTERVAL_SECONDS=5
PERP_TOF_ENABLED=true
PERP_OI_BUCKET_SIZE=100000
PERP_FUNDING_THRESHOLD=0.05
PERP_LIQUIDATION_WINDOW=5m
PERP_AGF_VOLUME_THRESHOLD=1000000
ADVANCED_TOF_ENABLED=true
CONTRACT_WHALE_ENABLED=true
CONTRACT_WHALE_DRY_RUN=true
CONTRACT_WHALE_AUTO_PUSH_INTERVAL_MS=2000
CONTRACT_WHALE_DISCORD_ENABLED=true
CONTRACT_WHALE_DISCORD_COOLDOWN_SEC=180
HOURLY_DELTA_ALERT_ENABLED=false
HOURLY_DELTA_ALERT_DRY_RUN=true
HOURLY_DELTA_ALERT_THRESHOLD_BTC=1000
# Optional dedicated webhook; falls back to CONTRACT_WHALE_DISCORD_WEBHOOK_URL / DISCORD_WEBHOOK_URL
HOURLY_DELTA_DISCORD_WEBHOOK_URL=
SPOT_WHALE_ENABLED=false
SPOT_WHALE_DRY_RUN=true
SPOT_WHALE_BINANCE_ENABLED=true
SPOT_WHALE_COINBASE_ENABLED=true
SPOT_WHALE_DISCORD_ENABLED=true
# Optional dedicated spot webhook; falls back to DISCORD_WEBHOOK_URL when empty.
SPOT_WHALE_DISCORD_WEBHOOK_URL=
SPOT_WHALE_DISCORD_COOLDOWN_SEC=180
ALLOW_LAN_DASHBOARD=false
ALLOWED_DASHBOARD_ORIGIN=http://127.0.0.1:3000
# Server-side only. Do not expose as VITE_* or embed in browser bundles.
OPERATOR_TOKEN=
OPERATOR_API_TOKEN=
DRY_RUN=true

SYMBOL=BTC-PERP
TOXIC_VOLUME_ALERT_BTC=1000

WINDOWS_MS=1000,5000,15000,60000
MARKOUT_HORIZONS_MS=1000,5000,15000
SWEEP_WINDOWS_MS=1000,5000,15000

ENABLE_BINANCE=false
ENABLE_BYBIT=false
ENABLE_OKX=false

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TOXIC_FLOW_SIDECAR_ENABLED=false
TOXIC_FLOW_SIDECAR_EVENTS_PATH=
DISCORD_WEBHOOK_URL=
ALERT_MIN_SCORE=80
ALERT_MIN_DATA_QUALITY=70
DISCORD_AUTO_PUSH_ENABLED=true
DISCORD_AUTO_PUSH_CACHED_ON_BOOT=false
DISCORD_AUTO_PUSH_INTERVAL_MS=1000

# New-token Binance USD-M local L2 is opt-in. Disabled keeps the page in
# public flow-only mode while the persisted watchlist remains intact.
NEW_TOKEN_L2_ENABLED=false
DISCORD_PUSH_COOLDOWN_SECONDS=60
ALERT_DEDUP_WINDOW_MS=30000
ALERT_MIN_SEVERITY=alert
ALERT_REQUIRE_CROSS_VENUE=true
ALERT_REQUIRE_MARKOUT=true
ALERT_REQUIRE_LIQUIDITY_DRAIN=false
SQLITE_ENABLED=true
SQLITE_PATH=.runtime/btc-toxic-flow.sqlite
SNAPSHOT_PERSIST_INTERVAL_MS=1000
RAW_SNAPSHOT_ENABLED=false
RAW_SNAPSHOT_SAMPLE_RATE_MS=1000
REPLAY_ENABLED=true
REPLAY_REPORT_DIR=.runtime/reports
VPIN_ENABLED=true
VPIN_BUCKET_SIZE_BTC=100
VPIN_LOOKBACK_BUCKETS=50
VPIN_MIN_BUCKETS=10
VPIN_SPIKE_ZSCORE=2.5
VPIN_HIGH_THRESHOLD=0.70
VPIN_EXTREME_THRESHOLD=0.85
VPIN_PERSIST_BUCKETS=true
LIQUIDATION_ENABLED=true
LIQUIDATION_LOOKBACK_MS=120000
LIQUIDATION_CLUSTER_BAND_BPS=6
LIQUIDATION_MIN_CLUSTER_DISTANCE_BPS=5
LIQUIDATION_MAX_CLUSTER_DISTANCE_BPS=150
LIQUIDATION_PROXIMITY_THRESHOLD_BPS=25
LIQUIDATION_MIN_CLUSTER_TOUCHES=3
LIQUIDATION_PRESSURE_THRESHOLD=0.65
LIQ_HUNT_CLUSTER_LARGE_NOTIONAL_USD=50000000
LIQ_HUNT_NEAR_DISTANCE_BPS=25
